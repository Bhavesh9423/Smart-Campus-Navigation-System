# ==============================================================================
# CampusNav Environment Configuration
# ==============================================================================

# Backend Configuration
PROJECT_NAME="CampusNav API"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Default uses local SQLite file for zero-config quick start.
# For production PostgreSQL / PostGIS:
# DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campusnav_db"
DATABASE_URL="sqlite:///./campusnav.db"

# JWT Security
SECRET_KEY="campusnav_super_secret_jwt_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Seeded automatically if database is fresh)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@campusnav.edu"
DEFAULT_ADMIN_PASSWORD="admin123"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_CAMPUS_NAME="Apex Institute of Technology & Science"
VITE_CAMPUS_SHORT_NAME="AITS Campus"
